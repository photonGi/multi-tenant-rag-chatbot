{
  "name": "@shoaibakhter.sysmatixx/chat-widget",
  "version": "0.2.0",
  "description": "Embed a Multi-Tenant Chatbot RAG assistant into any website. Framework wrappers around the widget loader.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "keywords": ["chatbot", "rag", "widget", "embed", "support", "assistant"],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "5.7.3"
  }
}

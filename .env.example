# =============================================================================
# Copy to .env.local and fill in. See SETUP.md, and WIDGET.md for the widget.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The widget's routes are anonymous — a visitor on a customer's
# website has no session — so they read widget_sites as service_role and do the
# authorisation in code. Required for the widget; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# For local development (optional, auto-detected in preview)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# ── Widget ───────────────────────────────────────────────────────────────────
# The stable domain customers paste into their websites. Required in production:
# the fallback is VERCEL_URL, which is per-deployment and so wrong for a snippet
# that has to keep working. Must match the DEFAULT_APP_URL baked into the
# published npm wrapper, or SPA installs will point at the wrong backend.
NEXT_PUBLIC_APP_URL=https://mt-rag-chatbots.vercel.app

# Signs widget session tokens. Falls back to SUPABASE_SERVICE_ROLE_KEY, which
# works but means rotating the database key signs every visitor out mid-chat.
#   openssl rand -hex 32
WIDGET_SESSION_SECRET=

# ── n8n ──────────────────────────────────────────────────────────────────────
# Defaults to the value in lib/n8n/client.ts when unset.
N8N_WEBHOOK_BASE_URL=

# Sent as X-Widget-Secret on server-to-n8n calls. Add a matching check to the
# workflow so the webhook only answers this backend.
#   openssl rand -hex 32
N8N_SHARED_SECRET=

# ── Meeting booking ──────────────────────────────────────────────────────────
# From a Google Cloud project with the Calendar and Gmail APIs enabled. The
# OAuth consent screen needs the calendar.events and gmail.send scopes; both are
# sensitive, so a production app has to be verified by Google before anyone
# outside the test-user list can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an Authorised redirect URI in the Google Cloud console character
# for character. Defaults to <NEXT_PUBLIC_APP_URL>/api/auth/google/callback,
# which is right for production and wrong for a preview deployment — set it
# explicitly when developing locally:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Encrypts the Google refresh and access tokens before they reach the database
# (AES-256-GCM). Required for the integration; without it the console refuses to
# start a consent flow rather than storing a credential in plaintext.
#
# Rotating this makes every stored connection unreadable and every workspace has
# to reconnect — it is not a value to regenerate casually.
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Signs the OAuth `state` parameter. Falls back to SUPABASE_SERVICE_ROLE_KEY.
#   openssl rand -hex 32
OAUTH_STATE_SECRET=

# The whole of the authentication on /api/internal/*, which is how the n8n
# booking workflow fetches a Google access token. Send it as X-Internal-Secret.
# Unset means every request to those routes is refused.
#   openssl rand -hex 32
INTERNAL_API_SECRET=
